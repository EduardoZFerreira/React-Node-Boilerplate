generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  // Set when the tenant was auto-created from a registrant's email domain (or
  // manually tagged by an Admin) — used to route later signups from the same
  // domain to "contact your manager" instead of creating a duplicate org.
  // NOT @unique: MongoDB unique indexes don't ignore nulls/missing fields the
  // way Postgres sparse-unique does, and most tenants have no domain at all —
  // race protection for the self-serve signup path instead comes from `slug`
  // (always unique, always derived deterministically from the domain there).
  domain    String?
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  users     User[]
  items     Item[]

  @@index([domain])
  @@map("tenants")
}

// Roles are embedded as String[] for fast auth lookups.
// The Role collection exists for admin role management only.
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  surname   String
  email     String   @unique
  password  String
  roles     String[] @default([])
  tenantId  String?  @db.ObjectId
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  ApiKey    ApiKey[]
  Item      Item[]

  // Forces a password change before anything else — set on bootstrap-seeded
  // Admins (see AdminBootstrapService) since the dev supplies the initial
  // password themselves via .env.
  mustResetPassword      Boolean   @default(false)
  // Hash of the "forgot password" token (never store the raw token) + its expiry.
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  @@index([resetPasswordTokenHash])
  @@map("users")
}

model Role {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  title String @unique

  @@map("roles")
}

model Item {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  isActive    Boolean  @default(true)
  tenantId    String?  @db.ObjectId
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  createdById String   @db.ObjectId
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("items")
}

// Session store — sid is the express-session ID used directly as _id.
model Session {
  sid       String    @id @map("_id")
  data      String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("sessions")
}

model ApiKey {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  label     String
  keyHash   String    @unique
  scopes    String[]
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("apiKeys")
}
