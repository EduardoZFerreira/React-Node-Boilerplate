generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  users     User[]
  items     Item[]

  @@map("tenants")
}

// Roles are embedded as String[] for fast auth lookups.
// The Role collection exists for admin role management only.
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  surname   String
  email     String   @unique
  password  String
  roles     String[] @default([])
  tenantId  String?  @db.ObjectId
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
  ApiKey    ApiKey[]
  Item      Item[]

  @@map("users")
}

model Role {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  title String @unique

  @@map("roles")
}

model Item {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  isActive    Boolean  @default(true)
  tenantId    String?  @db.ObjectId
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  createdById String   @db.ObjectId
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("items")
}

// Session store — sid is the express-session ID used directly as _id.
model Session {
  sid       String    @id @map("_id")
  data      String
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@map("sessions")
}

model ApiKey {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  label     String
  keyHash   String    @unique
  scopes    String[]
  expiresAt DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@map("apiKeys")
}
